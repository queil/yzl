<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>yzl</ToolCommandName>
    <Authors>queil</Authors>
    <Description>Yzl bindings generator - generates F# Yzl bindings from JSON Schema</Description>
    <Copyright>2020-2026 © queil</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RepositoryUrl>https://github.com/queil/yzl</RepositoryUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageIcon>yzl.png</PackageIcon>
    <VersionPrefix>0.4.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\.assets\yzl.png" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>

    <Compile Include="Patterns.fs" />
    <Compile Include="Program.fs" />
    
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.5" />
    <PackageReference Update="FSharp.Core" Version="10.0.103" />
    <PackageReference Include="NJsonSchema" Version="11.5.2" />
    <PackageReference Include="Yzl" Version="2.0.2" />

  </ItemGroup>

</Project>
